# Copia a deploy/compose/.env y rellena. Nunca subas el .env. Sin valores reales aquí.
POSTGRES_PASSWORD=
AGENTCORE_KEYS_FINGERPRINT=      # kid:base64(>=32 bytes), p. ej. fp-1:...
AGENTCORE_KEYS_TOKEN_MAP=        # kid:base64(>=32 bytes)
AGENTCORE_JEV_API_KEY=
OPENROUTER_API_KEY=
GATEWAY_TOKEN_AGENT_CORE=        # token que agent-core usa ante el llm-gateway
TOOL_SERVICE_TOKEN=              # token de agent-core ante el tool-service
TOOL_DATA_HOST_DIR=              # carpeta data/ de data-pipeline (con publish/latest.json)
AGENTCORE_GRANTS_URL=            # plataforma: /api/v1/internal/grants/{ref}
AGENTCORE_GRANTS_TOKEN=
# Opcionales: AGENTCORE_IMAGE, LLM_GATEWAY_IMAGE, TOOL_SERVICE_IMAGE, LLM_GATEWAY_CONTEXT, TOOL_SERVICE_CONTEXT,
# SERVE_PORT, AGENTCORE_MAX_INFLIGHT, AGENTCORE_DB_POOL_MAX, GIT_SHA
