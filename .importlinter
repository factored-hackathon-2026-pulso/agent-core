[importlinter:contract:knowledge_publica]
name = M12 (knowledge): quien lo importa (M2, M8, composition) usa solo su interfaz pública, no sus submódulos
type = forbidden
# `agent_core.knowledge` (su __init__) sí se puede importar; lo indirecto pasa por ahí.
allow_indirect_imports = True
source_modules =
    agent_core.flows
    agent_core.views
    agent_core.guards
    agent_core.actions
    agent_core.decision
    agent_core.response
    agent_core.interpreter
    agent_core.handoff
    agent_core.audit
    agent_core.turn
    agent_core.api
    agent_core.adapters
    agent_core.cli
    agent_core.composition
    agent_core.registry
forbidden_modules =
    agent_core.knowledge.*

[importlinter:contract:turn]
name = M4 (turn) solo usa domain, ports y interpreter, actions, decision, guards, handoff, audit
type = forbidden
# M4 importa interpreter, que a su vez usa flows y views: solo se prohíben los imports directos de M4.
allow_indirect_imports = True
source_modules =
    agent_core.turn
forbidden_modules =
    agent_core.flows
    agent_core.views
    agent_core.response
    agent_core.knowledge
    agent_core.api
    agent_core.adapters
    agent_core.cli
    agent_core.composition
    agent_core.contracts
    agent_core.registry

[importlinter:contract:api]
name = M9 (api) solo usa domain, ports y turn, handoff, audit
type = forbidden
source_modules =
    agent_core.api
forbidden_modules =
    agent_core.flows
    agent_core.views
    agent_core.guards
    agent_core.actions
    agent_core.decision
    agent_core.response
    agent_core.interpreter
    agent_core.knowledge
    agent_core.adapters
    agent_core.cli
    agent_core.composition
    agent_core.contracts
    agent_core.registry

[importlinter:contract:adapters]
name = adapters solo usa domain, ports
type = forbidden
source_modules =
    agent_core.adapters
forbidden_modules =
    agent_core.flows
    agent_core.views
    agent_core.guards
    agent_core.actions
    agent_core.decision
    agent_core.response
    agent_core.interpreter
    agent_core.handoff
    agent_core.audit
    agent_core.knowledge
    agent_core.turn
    agent_core.api
    agent_core.cli
    agent_core.composition
    agent_core.contracts
    agent_core.registry
ignore_imports =
    agent_core.adapters.llm.agent_port -> agent_core.interpreter

[importlinter:contract:registry]
name = Registry (unidad 2) solo usa domain, ports y flows
type = forbidden
source_modules =
    agent_core.registry
forbidden_modules =
    agent_core.views
    agent_core.guards
    agent_core.actions
    agent_core.decision
    agent_core.response
    agent_core.interpreter
    agent_core.handoff
    agent_core.audit
    agent_core.knowledge
    agent_core.turn
    agent_core.api
    agent_core.adapters
    agent_core.cli
    agent_core.composition
    agent_core.contracts

[importlinter:contract:domain_sin_ports]
name = domain no importa ports (los puertos dependen del dominio, no al revés)
type = forbidden
source_modules =
    agent_core.domain
forbidden_modules =
    agent_core.ports

[importlinter:contract:telemetry]
name = agent_telemetry no importa agent_core
type = forbidden
source_modules =
    agent_telemetry
forbidden_modules =
    agent_core
