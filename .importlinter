# Fronteras entre módulos (docs/specs/motor/00-indice.md §3).
# Si un módulo necesita importar otro que no está permitido aquí, es un cambio de interfaz: se decide primero en el spec.
# `agent_core.composition` es la raíz de composición (con `cli`): nadie la importa; ella puede importar todo.
[importlinter]
root_packages =
    agent_core
    agent_telemetry

[importlinter:contract:m0]
name = M0 (domain, ports) no importa ningún módulo
type = forbidden
source_modules =
    agent_core.domain
    agent_core.ports
forbidden_modules =
    agent_core.flows
    agent_core.views
    agent_core.guards
    agent_core.actions
    agent_core.decision
    agent_core.response
    agent_core.interpreter
    agent_core.handoff
    agent_core.audit
    agent_core.knowledge
    agent_core.turn
    agent_core.api
    agent_core.adapters
    agent_core.cli
    agent_core.composition
    agent_core.contracts
    agent_core.registry

[importlinter:contract:flows]
name = M1 (flows) solo usa domain, ports
type = forbidden
source_modules =
    agent_core.flows
forbidden_modules =
    agent_core.views
    agent_core.guards
    agent_core.actions
    agent_core.decision
    agent_core.response
    agent_core.interpreter
    agent_core.handoff
    agent_core.audit
    agent_core.knowledge
    agent_core.turn
    agent_core.api
    agent_core.adapters
    agent_core.cli
    agent_core.composition
    agent_core.contracts
    agent_core.registry

