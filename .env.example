# Claves de DEMO (EnvKeyProvider). Nunca claves reales. Formato: kid:base64(>=32 bytes), la primera es la vigente.
AGENTCORE_KEYS_FINGERPRINT=demo-fp-1:REPLACE_WITH_BASE64_32_BYTES
AGENTCORE_KEYS_TOKEN_MAP=demo-tm-1:REPLACE_WITH_BASE64_32_BYTES
AGENTCORE_JEV_API_KEY=REPLACE_WITH_JEV_API_KEY

# LLM gateway (unidad 5). Solo el nombre de la variable de la key va en el JSON; la key va en su variable.
# La key se deja vacía a propósito: un valor de relleno no está en blanco y produciría 401 en vez de "sin key".
LLM_ENDPOINTS='{"openrouter": {"base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY"}}'
OPENROUTER_API_KEY=

# Cómo correr `agentcore llm-smoke` (manual, fuera de CI):
#   1. Define las variables en el shell (este archivo no se carga solo). En PowerShell:
#        $env:LLM_ENDPOINTS = '{"openrouter": {"base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY"}}'
#        $env:OPENROUTER_API_KEY = "<tu key>"
#      En bash basta con `source .env` (el JSON va entre comillas simples).
#   2. El directorio de `--registry` necesita un `model_profile` YAML con `endpoint_alias: openrouter` y
#      `structured: prompted` (el nodo `agent` exige `prompted`).
#   3. uv run agentcore llm-smoke --registry <directorio> --profile <id@versión> --n 10
