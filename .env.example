# Claves de DEMO (EnvKeyProvider). Nunca claves reales. Formato: kid:base64(>=32 bytes), la primera es la vigente.
AGENTCORE_KEYS_FINGERPRINT=demo-fp-1:REPLACE_WITH_BASE64_32_BYTES
AGENTCORE_KEYS_TOKEN_MAP=demo-tm-1:REPLACE_WITH_BASE64_32_BYTES
AGENTCORE_JEV_API_KEY=REPLACE_WITH_JEV_API_KEY

# LLM gateway (ADR 0022): el servicio `llm-gateway` (otro repo) habla con los proveedores; aquí solo van su URL y el
# token de este consumidor. Las dos variables van juntas o ninguna (sin ellas toda generación cae a plantilla).
# Las keys de los proveedores (OPENROUTER_API_KEY, ...) y LLM_ENDPOINTS viven en el despliegue del servicio.
AGENTCORE_LLM_GATEWAY_URL=
AGENTCORE_LLM_GATEWAY_TOKEN=

# Cómo correr `agentcore llm-smoke` (manual, fuera de CI):
#   1. Levanta el servicio llm-gateway con un alias de proveedor (ver su README) y define aquí su URL y el token.
#      En PowerShell:
#        $env:AGENTCORE_LLM_GATEWAY_URL = "http://localhost:8080"
#        $env:AGENTCORE_LLM_GATEWAY_TOKEN = "<token de este consumidor>"
#      En bash basta con `source .env`.
#   2. El directorio de `--registry` necesita un `model_profile` YAML con `endpoint_alias` igual a un alias del
#      servicio (p. ej. `openrouter`) y `structured: prompted` (el nodo `agent` exige `prompted`).
#   3. uv run agentcore llm-smoke --registry <directorio> --profile <id@versión> --n 10
