{
  "$comment": "GENERADO por `uv run agentcore contracts`; no editar a mano.",
  "$defs": {
    "ActionSuggestion": {
      "additionalProperties": false,
      "description": "Una escritura preparada y NO ejecutable (`executable` es siempre `false`, ADR 0026 §7).",
      "properties": {
        "args": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Args",
          "type": "object"
        },
        "executable": {
          "const": false,
          "default": false,
          "title": "Executable",
          "type": "boolean"
        },
        "summary": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "tool": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "type": {
          "const": "action",
          "default": "action",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "summary"
      ],
      "title": "ActionSuggestion",
      "type": "object"
    },
    "AuthLevel": {
      "description": "Nivel de autenticación; se compara por rango (`anonymous < session < step_up`).",
      "enum": [
        "anonymous",
        "session",
        "step_up"
      ],
      "title": "AuthLevel",
      "type": "string"
    },
    "Awaiting": {
      "description": "Qué espera el run del usuario en el siguiente turno (M0 §2.7).",
      "enum": [
        "none",
        "slot",
        "confirmation",
        "step_up",
        "input"
      ],
      "title": "Awaiting",
      "type": "string"
    },
    "ConfirmationPrompt": {
      "additionalProperties": false,
      "description": "Forma interna; la API publica `summary.text` como `action_summary`.",
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Message"
        },
        "token": {
          "title": "Token",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "token",
        "expires_at",
        "summary"
      ],
      "title": "ConfirmationPrompt",
      "type": "object"
    },
    "EntityRef": {
      "additionalProperties": false,
      "description": "Referencia exacta de runtime: `id@X.Y.Z`.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_/-]*$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "EscalateSuggestion": {
      "additionalProperties": false,
      "description": "Recomendación de escalar. El motivo y la evidencia los fija el flow (una `rule`), no el modelo; el\nmodelo solo redacta `motive_draft`.",
      "properties": {
        "evidence": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "motive_draft": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Motive Draft",
          "type": "string"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "type": {
          "const": "escalate",
          "default": "escalate",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "reason_code",
        "evidence",
        "motive_draft"
      ],
      "title": "EscalateSuggestion",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "Message": {
      "additionalProperties": false,
      "description": "Mensaje al usuario: plantilla o generado, con su locale (M0 §2.8).",
      "properties": {
        "kind": {
          "enum": [
            "template",
            "generated"
          ],
          "title": "Kind",
          "type": "string"
        },
        "locale": {
          "pattern": "^[a-z]{2}$",
          "title": "Locale",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text",
        "locale"
      ],
      "title": "Message",
      "type": "object"
    },
    "Outcome": {
      "description": "Resultado final de un run (M0 §2.7).",
      "enum": [
        "resolved",
        "abstained",
        "cancelled",
        "clarify_exhausted",
        "completed",
        "failed",
        "abandoned",
        "escalated",
        "transferred"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "ReplySuggestion": {
      "additionalProperties": false,
      "description": "Borrador para el cliente. Lo redacta el modelo; M8 valida cifras y fechas contra los hechos citados.",
      "properties": {
        "citations": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Citations",
          "type": "array"
        },
        "language": {
          "pattern": "^[a-z]{2}$",
          "title": "Language",
          "type": "string"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "reply",
          "default": "reply",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "text",
        "language"
      ],
      "title": "ReplySuggestion",
      "type": "object"
    },
    "StepUpPrompt": {
      "additionalProperties": false,
      "description": "Solicitud de elevar el nivel de autenticación (M0 §2.8).",
      "properties": {
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "required_level": {
          "$ref": "#/$defs/AuthLevel"
        }
      },
      "required": [
        "required_level",
        "reason"
      ],
      "title": "StepUpPrompt",
      "type": "object"
    },
    "ToolSuggestion": {
      "additionalProperties": false,
      "description": "Una lectura que conviene mirar. `tool` ∈ `suggest.tools_allowed`; el sujeto nunca es argumento.",
      "properties": {
        "args": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Args",
          "type": "object"
        },
        "tool": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "type": {
          "const": "tool",
          "default": "tool",
          "title": "Type",
          "type": "string"
        },
        "why": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Why",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "why"
      ],
      "title": "ToolSuggestion",
      "type": "object"
    },
    "TurnResult": {
      "additionalProperties": false,
      "description": "Resultado de un turno: mensajes, estado esperado y outcome (M0 §2.8).",
      "properties": {
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntityRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "awaiting": {
          "$ref": "#/$defs/Awaiting"
        },
        "confirmation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfirmationPrompt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "handoff_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Handoff Ref"
        },
        "locale": {
          "pattern": "^[a-z]{2}$",
          "title": "Locale",
          "type": "string"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "title": "Messages",
          "type": "array"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/Outcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "open",
            "closed",
            "escalated"
          ],
          "title": "Status",
          "type": "string"
        },
        "step_up": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepUpPrompt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        },
        "turn_id": {
          "title": "Turn Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "turn_id",
        "messages",
        "locale",
        "awaiting",
        "status",
        "trace_id"
      ],
      "title": "TurnResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Resultado de crear o consultar un run (M0 §2.8).",
  "properties": {
    "first_turn": {
      "anyOf": [
        {
          "$ref": "#/$defs/TurnResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "handoff_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Handoff Ref"
    },
    "outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/Outcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "output": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output"
    },
    "release": {
      "title": "Release",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "status": {
      "enum": [
        "open",
        "closed",
        "escalated"
      ],
      "title": "Status",
      "type": "string"
    },
    "suggestions": {
      "items": {
        "discriminator": {
          "mapping": {
            "action": "#/$defs/ActionSuggestion",
            "escalate": "#/$defs/EscalateSuggestion",
            "reply": "#/$defs/ReplySuggestion",
            "tool": "#/$defs/ToolSuggestion"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ReplySuggestion"
          },
          {
            "$ref": "#/$defs/ToolSuggestion"
          },
          {
            "$ref": "#/$defs/ActionSuggestion"
          },
          {
            "$ref": "#/$defs/EscalateSuggestion"
          }
        ]
      },
      "title": "Suggestions",
      "type": "array"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "release",
    "status",
    "trace_id"
  ],
  "title": "RunResult",
  "type": "object"
}
