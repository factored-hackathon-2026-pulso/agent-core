          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Turn Id"
        },
        "guards": {
          "anyOf": [
            {
              "$ref": "#/$defs/GuardsOutput"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "TurnStartedPayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
