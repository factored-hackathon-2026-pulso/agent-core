          "default": null,
          "title": "Locale Prior"
        },
        "top2": {
          "items": {
            "$ref": "#/$defs/LangScore"
          },
          "title": "Top2",
          "type": "array"
        }
      },
      "required": [
        "detector",
        "letters",
        "top2",
        "decision",
        "locale"
      ],
      "title": "LangGuard",
      "type": "object"
    },
    "LangScore": {
      "additionalProperties": false,
      "properties": {
        "lang": {
          "title": "Lang",
          "type": "string"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "lang",
        "score"
      ],
      "title": "LangScore",
      "type": "object"
    },
    "TurnStartedPayload": {
      "additionalProperties": false,
