{
  "$comment": "GENERADO por `uv run agentcore contracts`; no editar a mano.",
  "$defs": {
    "EntityRef": {
      "additionalProperties": false,
      "description": "Referencia exacta de runtime: `id@X.Y.Z`.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_/-]*$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "PrincipalType": {
      "enum": [
        "customer",
        "advisor",
        "service",
        "builder"
      ],
      "title": "PrincipalType",
      "type": "string"
    },
    "RunStartedPayload": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/EntityRef"
        },
        "locale": {
          "pattern": "^[a-z]{2}$",
          "title": "Locale",
          "type": "string"
        },
        "mode": {
          "enum": [
            "conversational",
            "task"
          ],
          "title": "Mode",
          "type": "string"
        },
        "principal_type": {
          "$ref": "#/$defs/PrincipalType"
        },
        "reportable_attrs": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Reportable Attrs",
          "type": "object"
        },
        "subject_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Kind"
        }
      },
      "required": [
        "agent",
        "mode",
        "principal_type",
        "locale"
      ],
      "title": "RunStartedPayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hash"
    },
    "payload": {
      "$ref": "#/$defs/RunStartedPayload"
    },
    "prev_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prev Hash"
    },
    "release": {
      "title": "Release",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "seq": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seq"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "turn_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Turn Id"
    },
    "type": {
      "const": "run_started",
      "default": "run_started",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "run_id",
    "release",
    "ts",
    "payload"
  ],
  "title": "RunStarted",
  "type": "object"
}
