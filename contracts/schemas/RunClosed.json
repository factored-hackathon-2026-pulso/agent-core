{
  "$comment": "GENERADO por `uv run agentcore contracts`; no editar a mano.",
  "$defs": {
    "Outcome": {
      "enum": [
        "resolved",
        "abstained",
        "cancelled",
        "clarify_exhausted",
        "completed",
        "failed",
        "abandoned",
        "escalated"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "RunClosedPayload": {
      "additionalProperties": false,
      "properties": {
        "closed_by": {
          "enum": [
            "flow",
            "abandonment",
            "escalation",
            "revocation"
          ],
          "title": "Closed By",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        }
      },
      "required": [
        "outcome",
        "closed_by"
      ],
      "title": "RunClosedPayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hash"
    },
    "payload": {
      "$ref": "#/$defs/RunClosedPayload"
    },
    "prev_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prev Hash"
    },
    "release": {
      "title": "Release",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "seq": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seq"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "turn_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Turn Id"
    },
    "type": {
      "const": "run_closed",
      "default": "run_closed",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "run_id",
    "release",
    "ts",
    "payload"
  ],
  "title": "RunClosed",
  "type": "object"
}
