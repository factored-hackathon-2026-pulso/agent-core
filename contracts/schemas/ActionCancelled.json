{
  "$comment": "GENERADO por `uv run agentcore contracts`; no editar a mano.",
  "$defs": {
    "ActionCancelledPayload": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/InvalidationReason"
        }
      },
      "required": [
        "action_id",
        "reason"
      ],
      "title": "ActionCancelledPayload",
      "type": "object"
    },
    "InvalidationReason": {
      "enum": [
        "cancel",
        "abandoned",
        "interrupt",
        "escalated",
        "token_expired",
        "max_attempts",
        "denied_by_user"
      ],
      "title": "InvalidationReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hash"
    },
    "payload": {
      "$ref": "#/$defs/ActionCancelledPayload"
    },
    "prev_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prev Hash"
    },
    "release": {
      "title": "Release",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "seq": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seq"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "turn_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Turn Id"
    },
    "type": {
      "const": "action_cancelled",
      "default": "action_cancelled",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "run_id",
    "release",
    "ts",
    "payload"
  ],
  "title": "ActionCancelled",
  "type": "object"
}
